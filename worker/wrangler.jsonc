{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momentum-api-public",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://therandomhuman-hub.github.io"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_IP_RATE_LIMIT",
      "namespace_id": "2101",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "AUTH_IP_RATE_LIMIT",
      "namespace_id": "2102",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "services": [
    { "binding": "ENGINE", "service": "momentum-engine" },
    { "binding": "BILLING", "service": "momentum-billing" },
    { "binding": "AUTH", "service": "momentum-auth" }
  ]
}
