# Local/deployment configuration reference.
# Never put real credentials in this file.

# Public application
PUBLIC_APP_ORIGIN=https://therandomhuman-hub.github.io
RAZORPAY_SUBSCRIPTION_URL=https://rzp.io/rzp/example

# Cloudflare deployment
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google authentication
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com

# Momentum private engine
MOMENTUM_GITHUB_TOKEN=
MOMENTUM_API_KEY_PEPPER=
MOMENTUM_ADMIN_SECRET=

# Razorpay billing
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=plan_example
RAZORPAY_WEBHOOK_SECRET=

# Optional Razorpay test-mode billing
RAZORPAY_TEST_PRO_PLAN_ID=plan_test_example
RAZORPAY_TEST_WEBHOOK_SECRET=

# Legacy staging placeholders retained only for local tooling that still expects them.
ENGINE_BASE_URL=http://momentum-engine-staging:8000
ENGINE_SHARED_SECRET=
